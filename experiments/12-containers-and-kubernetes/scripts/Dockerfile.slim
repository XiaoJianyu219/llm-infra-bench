# 对比行 3：换成纯 CPU 基座。本服务不需要 CUDA，整座 CUDA 基座都是浪费。
# 这一行还没有做任何瘦身技巧，用来和下面的多阶段/清缓存版本对比。
ARG PIP_INDEX_URL=https://pypi.org/simple/
FROM python:3.12-slim
ARG PIP_INDEX_URL
WORKDIR /app
COPY requirements.txt .
# 单阶段、且故意不加 --no-cache-dir：pip 缓存会留在镜像层里，作为对比基准
RUN pip install --index-url "$PIP_INDEX_URL" --trusted-host mirrors.aliyun.com -r requirements.txt
COPY app.py .
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
